{
  "layer": "top",
  "position": "bottom",
  "modules-left": ["hyprland/workspaces", "custom/separator", "hyprland/window"],
  "modules-center": ["clock"],
  // "modules-right": ["battery", "hyprland/language", "pulseaudio", "bluetooth", "tray"],
  "modules-right": ["network", "cpu", "memory", "battery", "hyprland/language", "pulseaudio", "bluetooth", "tray"],

  // -------------------------------------------------------------------------
  // Modules
  // -------------------------------------------------------------------------

  "hyprland/window": {
    "max-length": 50
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "persistent-workspaces": {
      "*": 4
    },
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    }
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": [" ", " ", " ", " ", " "]
  },
  "hyprland/language": {
    "format": " {short} {variant}",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-bluetooth": "{volume}%",
    "format-muted": "",
    "format-icons": {
        "default": ["", ""]
    },
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}"
  },
  "tray": {
    "format": "{icons}",
    "icon-size": 20,
    "spacing": 4
  },
  "bluetooth": {
    "on-click": "~/.config/waybar/scripts/rofi-bluetooth &",
    "format": " {status}",
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "tooltip": true
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "tooltip": true
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  }
}
